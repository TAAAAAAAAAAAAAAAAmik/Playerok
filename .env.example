# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Polling interval in seconds (default: 30)
POLL_INTERVAL=30

# Playerok token is saved automatically after /login — no need to set it manually

# ── Создание товара через браузер (Selenium) ──────────────────────────────
# Токен сессии Playerok из DevTools (Application → Cookies → token).
# Куку __ddg5_ добавлять не нужно: она привязана к IP, браузер получит свою.
PLAYEROK_COOKIES=token=eyJ...

# 1 — запускать браузер без окна (DDoS-Guard к такому строже, по умолчанию 0)
SELENIUM_HEADLESS=0
SELENIUM_TIMEOUT=20
# Профиль Chrome — чтобы не логиниться каждый запуск
SELENIUM_PROFILE_DIR=.chrome-profile
# Пути, если Chrome/chromedriver лежат не в PATH
CHROME_BINARY=
CHROMEDRIVER_PATH=
# 1 — мобильная вёрстка (браузер прикидывается телефоном Pixel 7)
SELENIUM_MOBILE=0
# 1 — выполнять запросы к API внутри браузера (если защита режет прямые)
PLAYEROK_BROWSER_TRANSPORT=0
# Чем создавать товар: api (запросами) или browser (мастер в Selenium)
CREATE_MODE=api
