# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Уведомления уходят в этот чат, и только из него принимаются команды.
TELEGRAM_CHAT_ID=your_chat_id_here

# Интервал опроса в секундах (по умолчанию 30)
POLL_INTERVAL=30

# Сколько сделок запрашивать за раз; Playerok отдаёт максимум 24.
#DEAL_FETCH_COUNT=24

# По умолчанию первый проход молча запоминает существующие сделки.
# true — уведомлять и о них тоже.
#NOTIFY_ON_FIRST_RUN=false

# Если ссылки на лоты в уведомлениях ведут на 404 — поправьте шаблон здесь.
#ITEM_URL_TEMPLATE=https://playerok.com/products/{slug}

# Токен Playerok сюда не нужен: он сохраняется в .playerok_token после /login
